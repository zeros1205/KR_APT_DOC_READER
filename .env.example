# ────────────────────────────────────────────────────
# API Keys Configuration
# 아래 항목들을 자신의 API 키로 채워주세요
# ────────────────────────────────────────────────────

# 【Anthropic Claude API】
# 용도: Claude Haiku (팩트 추출 보조)
# 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-

# 【OpenAI API】
# 용도: GPT-4 (콘텐츠 생성)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-

# 【Google Gemini API】
# 용도: Gemini 3.1 Flash, Flash Lite (메인 LLM)
# 발급: https://ai.google.dev/
GEMINI_API_KEY=AIzaSy

# 【청약홈 공공데이터 OpenAPI】
# 용도: 분양공고 데이터 수집
# 발급: https://www.data.go.kr/
# 검색: "한국부동산원_청약홈 분양정보 조회 서비스"
PUBLIC_DATA_API_KEY=

# 【Unsplash API】
# 용도: 이미지 자동 수집
# 발급: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# 【Pexels API】
# 용도: 이미지 자동 수집
# 발급: https://www.pexels.com/api/
PEXELS_API_KEY=

# ────────────────────────────────────────────────────
# Database Configuration
# ────────────────────────────────────────────────────

# SQLite 경로 (기본값)
# DATABASE_URL=sqlite:///./apt_reader.db

# PostgreSQL (프로덕션)
# DATABASE_URL=postgresql://user:password@localhost:5432/apt_reader

# ────────────────────────────────────────────────────
# Blog Configuration
# ────────────────────────────────────────────────────

# 블로그 테마: claude | notion | intercom | airbnb | stripe | apple | mintlify
BLOG_THEME=claude

# ────────────────────────────────────────────────────
# 주의사항
# ────────────────────────────────────────────────────
# 1. 이 파일은 .gitignore에 등록되어 절대 git에 커밋되지 않습니다
# 2. 개인의 API 키를 절대 공유하지 마세요
# 3. 로컬 개발 시에만 사용하고, 배포는 GitHub Secrets를 사용하세요
