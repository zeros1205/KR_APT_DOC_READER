# .env.example → 복사하여 .env로 저장 후 실제 키 입력
# cp .env.example .env

# ── OpenAI ──
OPENAI_API_KEY=sk-...

# ── 이미지 API (둘 다 무료 플랜 사용 가능) ──
# Unsplash: https://unsplash.com/developers (무료 50회/시간)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Pexels: https://www.pexels.com/api/ (무료 200회/시간)
PEXELS_API_KEY=your_pexels_api_key

# ── 청약홈 공공데이터 API ──
# 발급: https://www.data.go.kr → "청약홈 분양정보" 검색
PUBLIC_DATA_API_KEY=your_public_data_api_key

# ── CPA/제휴 링크 (실제 제휴 링크로 교체) ──
CTA_LOAN_COMPARE=https://finda.co.kr/
CTA_INTERIOR=https://ohou.se/
CTA_MOVING=https://www.zim.co.kr/
CTA_TAX=https://www.nts.go.kr/
CTA_KAKAO_CHANNEL=https://pf.kakao.com/YOUR_CHANNEL_ID
