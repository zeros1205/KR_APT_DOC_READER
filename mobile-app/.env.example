# 앱 버전 (CI 에서 주입; 없으면 0.1.0)
VITE_APP_VERSION=0.1.0

# App Store URL (iOS 업데이트 버튼 링크). 미설정 시 코드 기본값 사용.
VITE_APP_STORE_URL=https://apps.apple.com/app/id6745796757

# ── AdMob ──────────────────────────────────────────────────────────────
# 비공개 테스트 / CI 빌드에서는 비워두면 Google 공개 테스트 광고가 자동 표시됨.
# 실 광고 단위 ID 는 AdMob 콘솔에서 발급 후, 스토어 공개 출시 직전에만 주입.

# 배너 광고 단위 ID — Android (런타임 주입, Vite import.meta.env)
# 예: ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
VITE_ADMOB_BANNER_ID_ANDROID=

# 배너 광고 단위 ID — iOS (런타임 주입, Vite import.meta.env)
# 예: ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
VITE_ADMOB_BANNER_ID_IOS=

# Medium Rectangle (300x250) 광고 단위 ID — 종료 다이얼로그용
VITE_ADMOB_MREC_ID_ANDROID=
VITE_ADMOB_MREC_ID_IOS=

# 전면 광고(Interstitial) — 상세 10 회/30 분 마다 1 회 노출
VITE_ADMOB_INTERSTITIAL_ID_ANDROID=
VITE_ADMOB_INTERSTITIAL_ID_IOS=

# 앱 오프닝 광고 — 콜드 스타트 / foreground 복귀 시 4 시간 룰
VITE_ADMOB_APP_OPEN_ID_ANDROID=
VITE_ADMOB_APP_OPEN_ID_IOS=

# 네이티브 고급형 광고 — 메인 카드 그리드 인피드(카드 N개마다 1개)
VITE_ADMOB_NATIVE_ID_ANDROID=
VITE_ADMOB_NATIVE_ID_IOS=

# 실 광고 단위 ID 를 넣더라도 강제로 테스트 모드로 돌리려면 "true"
VITE_ADMOB_USE_TEST=

# AdMob 앱 ID 는 .env 가 아니라 네이티브 프로젝트 설정에 직접 박혀 있음 (런타임이 아닌 빌드 시점 값).
#  - Android: android/app/src/main/AndroidManifest.xml 의 com.google.android.gms.ads.APPLICATION_ID meta-data
#  - iOS    : ios/App/App/Info.plist 의 GADApplicationIdentifier 키
# 변경 필요 시 위 파일을 직접 수정.
