# 앱 버전 (CI 에서 주입; 없으면 0.1.0)
VITE_APP_VERSION=0.1.0

# App Store URL (iOS 업데이트 버튼 링크). 미설정 시 코드 기본값 사용.
VITE_APP_STORE_URL=https://apps.apple.com/app/id6745796757

# ── AdMob (Android 전용) ───────────────────────────────────────────────
# 비공개 테스트 / CI 빌드에서는 둘 다 비워두면 자동으로 Google 공개 테스트 광고가 표시됨.
# 실 광고 단위 ID 는 AdMob 콘솔에서 발급 후, 스토어 공개 출시 직전에만 주입.

# 배너 광고 단위 ID (런타임 주입 — Vite import.meta.env 로 번들 시점 결정)
# 예: ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
VITE_ADMOB_BANNER_ID_ANDROID=

# 실 광고 단위 ID 를 넣더라도 강제로 테스트 모드로 돌리려면 "true"
VITE_ADMOB_USE_TEST=

# AdMob 앱 ID (AndroidManifest 의 com.google.android.gms.ads.APPLICATION_ID 에 주입)
# build.gradle 에서 System.getenv() 로 읽음. 미설정 시 Google 공개 테스트 앱 ID 사용.
# 예: ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
# ADMOB_APP_ID_ANDROID=
