<?xml version="1.0" encoding="utf-8"?>
<!--
  네이티브 광고 카드 레이아웃. 웹 .post-card 의 모양(흰 배경, 라운드, 미디어 → 헤드라인
  → 본문 → CTA 버튼)을 최대한 닮게 구성. 우상단 "광고" 배지는 AdMob 정책상 필수.
  루트는 반드시 NativeAdView 여야 에셋 등록/트래킹이 동작한다.
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_native_ad_card"
        android:clipToOutline="true">

        <!-- 미디어(광고 이미지/동영상) 영역 + "광고" 배지 오버레이 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.gms.ads.nativead.MediaView
                android:id="@+id/ad_media"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#ECEAE3" />

            <TextView
                android:id="@+id/ad_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="9dp"
                android:background="@drawable/bg_native_ad_badge"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="광고"
                android:textColor="#767370"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ad_advertiser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="11dp"
                android:background="#52000000"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 본문(헤드라인 + 설명) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="13dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/ad_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#2C2925"
                android:textSize="17sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.15" />

            <TextView
                android:id="@+id/ad_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="#767370"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>

        <!-- CTA 버튼 — 웹 .card-cta 와 동일한 회색 풀폭 버튼 -->
        <TextView
            android:id="@+id/ad_cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_native_ad_cta"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
